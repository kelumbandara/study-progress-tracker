# Never bake secrets, local data or build junk into the image
.env
.env.*
!.env.example
.git
.gitignore
.idea
.vscode

# Installed inside the image by composer
vendor
node_modules
tests/e2e/node_modules
tests/e2e/shots

# Local-only data and caches
backups
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.phpunit.cache
.phpunit.result.cache
public/hot
public/storage

# Not needed at runtime
Dockerfile
.dockerignore
docs
scripts
*.md
!README.md

mobile
