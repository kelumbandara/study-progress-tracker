{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ezexam.edusl.net"
      }
    },
    "emulator-test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8081",
        "EXPO_PUBLIC_ALLOW_HTTP": "1",
        "ALLOW_CLEARTEXT": "1"
      }
    }
  }
}
